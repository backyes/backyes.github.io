    --bg: #191919; --bg-secondary: #202020; --bg-hover: #2f2f2f;
    --text: #e8e8e5; --text-secondary: #9b9a97; --text-muted: #6b7280;
    --border: #373737; --accent: #529cca; --accent-bg: #252525;
    --code-bg: #2f2f2f; --code-text: #ff7b72;
    --blockquote-border: #373737; --table-border: #373737; --table-header-bg: #252525;
  }
}
