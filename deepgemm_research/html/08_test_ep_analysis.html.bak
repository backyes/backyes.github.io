        <span style="color: #BA2121">f&#39;</span><span style="color: #A45A77; font-weight: bold">{</span>num_scaleup_bytes<span style="color: #BBB"> </span><span style="color: #666">/</span><span style="color: #BBB"> </span>t<span style="color: #BBB"> </span><span style="color: #666">/</span><span style="color: #BBB"> </span><span style="color: #666">1e9</span><span style="color: #A45A77; font-weight: bold">:</span><span style="color: #BA2121">.0f</span><span style="color: #A45A77; font-weight: bold">}</span><span style="color: #BA2121"> GB/s (SU), </span><span style="color: #A45A77; font-weight: bold">{</span>t<span style="color: #BBB"> </span><span style="color: #666">*</span><span style="color: #BBB"> </span><span style="color: #666">1e6</span><span style="color: #A45A77; font-weight: bold">:</span><span style="color: #BA2121">.3f</span><span style="color: #A45A77; font-weight: bold">}</span><span style="color: #BA2121"> us, </span><span style="color: #A45A77; font-weight: bold">{</span>num_scaleup_bytes<span style="color: #A45A77; font-weight: bold">:</span><span style="color: #BA2121">.0f</span><span style="color: #A45A77; font-weight: bold">}</span><span style="color: #BA2121"> bytes | &#39;</span>
        <span style="color: #BA2121">f&#39;copy: </span><span style="color: #A45A77; font-weight: bold">{</span><span style="color: #666">2</span><span style="color: #BBB"> </span><span style="color: #666">*</span><span style="color: #BBB"> </span>num_recv_tokens<span style="color: #BBB"> </span><span style="color: #666">*</span><span style="color: #BBB"> </span>num_bytes_per_dispatch_token<span style="color: #BBB"> </span><span style="color: #666">/</span><span style="color: #BBB"> </span>copy_t<span style="color: #BBB"> </span><span style="color: #666">/</span><span style="color: #BBB"> </span><span style="color: #666">1e9</span><span style="color: #A45A77; font-weight: bold">:</span><span style="color: #BA2121">.0f</span><span style="color: #A45A77; font-weight: bold">}</span><span style="color: #BA2121"> GB/s, </span><span style="color: #A45A77; font-weight: bold">{</span>copy_t<span style="color: #BBB"> </span><span style="color: #666">*</span><span style="color: #BBB"> </span><span style="color: #666">1e6</span><span style="color: #A45A77; font-weight: bold">:</span><span style="color: #BA2121">.3f</span><span style="color: #A45A77; font-weight: bold">}</span><span style="color: #BA2121"> us&#39;</span>)
