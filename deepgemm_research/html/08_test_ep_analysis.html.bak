dist_print(<span style="color: #BA2121">f&#39;   * EP: </span><span style="color: #A45A77; font-weight: bold">{</span>buffer<span style="color: #666">.</span>rank_idx<span style="color: #A45A77; font-weight: bold">:</span><span style="color: #BA2121">3</span><span style="color: #A45A77; font-weight: bold">}</span><span style="color: #BA2121">/</span><span style="color: #A45A77; font-weight: bold">{</span>buffer<span style="color: #666">.</span>num_ranks<span style="color: #A45A77; font-weight: bold">}</span><span style="color: #BA2121"> | &#39;</span>
