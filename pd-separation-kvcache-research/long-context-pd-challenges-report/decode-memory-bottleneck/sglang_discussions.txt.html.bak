}
a{color:var(--green);text-decoration:none}
a:hover{text-decoration:underline}
h1,h2,h3,h4{font-family:var(--font-serif);color:var(--ink);margin:1.5em 0 .5em}
h1{font-size:2rem;border-bottom:2px solid var(--green);padding-bottom:12px}
