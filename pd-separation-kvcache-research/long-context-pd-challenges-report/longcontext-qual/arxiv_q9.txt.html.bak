<style>
:root {
  --paper: #f6f3ec;
  --paper-light: #fcfaf6;
  --surface: rgba(255,255,255,0.86);
  --surface-strong: #ffffff;
  --line: rgba(17,17,17,0.12);
  --ink: #111111;
  --ink-soft: #4d4d4d;
  --ink-mute: #6a6a6a;
  --green: #0f5d44;
  --green-deep: #0a3f30;
  --green-soft: rgba(15,93,68,0.10);
