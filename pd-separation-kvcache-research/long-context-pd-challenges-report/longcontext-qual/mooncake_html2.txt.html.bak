  --green-line: rgba(15,93,68,0.25);
  --gold: #bf8b2c;
  --gold-soft: rgba(191,139,44,0.14);
  --blue: #163e7a;
  --red: #c0392b;
  --font-serif: 'Libre Baskerville', Georgia, serif;
  --font-sans: 'Manrope', 'Segoe UI', sans-serif;
