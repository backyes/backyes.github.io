code{background:var(--green-soft);padding:2px 6px;border-radius:4px}
pre{background:var(--surface-strong);border:1px solid var(--line);border-radius:var(--radius-sm);padding:16px;overflow-x:auto}
blockquote{border-left:3px solid var(--green);background:var(--green-soft);padding:12px 16px;margin:1em 0;font-style:italic}
table{border-collapse:collapse;width:100%;margin:1em 0;font-size:.9rem}
th{background:var(--green-soft);color:var(--green-deep);font-weight:600;padding:10px 14px;border:1px solid var(--line)}
td{padding:10px 14px;border:1px solid var(--line)}
tr:nth-child(even){background:rgba(15,93,68,.03)}
tr:hover{background:var(--green-soft)}
hr{border:none;border-top:1px solid var(--line);margin:2em 0}
img{max-width:100%;border-radius:var(--radius-sm)}

